# Copy to .env and fill in what you use. All keys are optional except the ones
# for features you actually enable.
#
# NEVER put real API keys, tokens, or passwords in this file or commit them.
# Real secrets belong only in a private .env (gitignored). If a key may have
# been exposed to chat/tooling, rotate it in the provider dashboard and update
# .env — do not paste secrets into commits or chat.

# JARVIS_OPENAI_API_KEY=
# JARVIS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Keep models in VRAM after use (Ollama default is ~5m → cold reload spikes).
# Chat / embed / extraction / rerank:
# JARVIS_OLLAMA_KEEP_ALIVE=30m
# Voice agent when voice_model ≠ chat_model (shorter frees VRAM for chat sooner):
# JARVIS_OLLAMA_VOICE_KEEP_ALIVE=30m
# Pin forever until `ollama stop <model>`: JARVIS_OLLAMA_KEEP_ALIVE=-1
# Opt-in: load chat (+ embed) at Jarvis boot (skips first-turn cold load):
# JARVIS_OLLAMA_WARM_ON_BOOT=false
# JARVIS_CHUNK_DECISION_MODEL=qwen3.5:2b
# JARVIS_CHUNK_DECISION_PROVIDER=ollama
# Voice LLM is profile.voice_model (Settings → Models → Voice), default
# qwen3.5:2b — independent of chat_model. Edit config/profiles.json or the UI.
# Tip: `ollama ps` shows what is loaded; switching chat↔voice on one GPU still
# incurs a swap spike if both do not fit in VRAM with Fish TTS.
# Vector / hybrid RAG store (Postgres + pgvector). Not the same as data/jarvis.db
# (SQLite — scheduler jobs only). Lab credentials match docker-compose defaults.
# Start DB: powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-up.ps1
# JARVIS_DATABASE_URL=postgresql://jarvis:jarvis@127.0.0.1:5432/jarvis
# Compose substitutes these when present (defaults are jarvis / jarvis / jarvis):
# POSTGRES_USER=jarvis
# POSTGRES_PASSWORD=jarvis
# POSTGRES_DB=jarvis
# When true and a URL is set, refuse to boot if Postgres is unreachable
# (no PlaceholderRetrievalEngine fallback):
# JARVIS_DATABASE_REQUIRED=false
# JARVIS_ALLOW_NON_LOOPBACK=false
#

# Model recommendations: curated catalog is offline. Opt in to Hugging Face Hub
# enrichment (downloads/likes, 24h disk cache under data/cache/hf_metrics/).
# JARVIS_MODEL_METRICS_ONLINE=false
# Optional token for higher HF rate limits (never required; do not commit).
# JARVIS_HF_TOKEN=

# Rate limits (stdlib, in-process sliding windows). Apply to remote /
# untrusted clients. Loopback (desktop / Vite) and /api/health are exempt.
# Validated API tokens also skip the per-IP bucket.
# JARVIS_RATE_LIMIT=60/minute
# JARVIS_RATE_LIMIT_PER_USER=120/minute
# JARVIS_RATE_LIMIT_GLOBAL=300/minute
# LangSmith (process gate). Profile also needs tracing_enabled=true.
# Use the JARVIS_ prefix — bare LANGSMITH_* vars are ignored by Settings.
# JARVIS_LANGSMITH_TRACING_V2=false
# JARVIS_LANGSMITH_PROJECT=jarvis
# JARVIS_LANGSMITH_API_KEY=
# JARVIS_LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Obsidian Local REST API plugin.
# JARVIS_OBSIDIAN_REST_URL=http://127.0.0.1:27123
# JARVIS_OBSIDIAN_API_KEY=
#
# Rotate the Obsidian API key if it may have leaked (user action — Jarvis
# cannot rotate it for you):
# 1. In Obsidian: Settings → Community plugins → Local REST API → API Key
#    → generate / copy a new key (or delete the old one and create a new one).
# 2. Update JARVIS_OBSIDIAN_API_KEY here (and restart the Jarvis backend).
# 3. Treat any previous key as burned; do not paste keys into chat or commits.
# Prompt role-splitting does not protect this secret; PolicyEngine and your
# Obsidian plugin settings do.

# Local API auth. Protected /api/* routes (everything except /api/health)
# require Authorization: Bearer <token> or X-Jarvis-Token.
# The Tauri desktop shell and scripts/start-web.ps1 mint/inject a session token.
# JARVIS_ALLOW_UNAUTHENTICATED_API=true is lab/pytest only (loopback); refused
# together with JARVIS_ALLOW_NON_LOOPBACK. Prefer a real token for Vite-dev:
# set JARVIS_API_TOKEN here and VITE_JARVIS_API_TOKEN in frontend/.env (or let
# start-web.ps1 mint both for the session).
# JARVIS_API_TOKEN=
# JARVIS_ALLOW_UNAUTHENTICATED_API=false
# JARVIS_APP_ENV=development

# --- Public NASA Hackathime demo (Render) ---------------------------------
# Hosted builds MUST keep demo mode on (production + non-loopback refuses boot
# without it). Users bring their own OpenAI-compatible key for chat (session
# header only — never store user keys in env).
# JARVIS_DEMO_MODE=true
# JARVIS_APP_ENV=production
# JARVIS_ALLOW_NON_LOOPBACK=true
# JARVIS_HOST=0.0.0.0
# JARVIS_CORS_ORIGINS=["https://your-demo.vercel.app"]
# JARVIS_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# JARVIS_SUPABASE_ANON_KEY=
# JARVIS_DATABASE_URL=postgresql://...  # Supabase pooler URI (TLS)
# JARVIS_DATABASE_REQUIRED=true
# Optional operator token for one-time sample vault reindex (not user chat):
# JARVIS_API_TOKEN=
# Optional operator OpenAI key for embeddings during that reindex only:
# JARVIS_OPENAI_API_KEY=
# JARVIS_RATE_LIMIT=20/minute
# JARVIS_RATE_LIMIT_PER_USER=30/minute
# JARVIS_RATE_LIMIT_GLOBAL=200/minute
# JARVIS_MAX_REQUEST_BODY_BYTES=65536
# Larger budget for Settings → Add documents uploads (base64 JSON):
# JARVIS_MAX_INGEST_BODY_BYTES=14000000
# Frontend (Vercel) may only use VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY,
# VITE_API_BASE_URL, VITE_DEMO_MODE — never service-role or OpenAI keys.
# Tell demo users: rotate their provider key after each session.
# Local Fish Speech TTS (OpenAudio S1-mini). Fish runs separately — see
# scripts/fish-speech-up.ps1. Jarvis POSTs to /v1/tts; Web Speech is fallback
# when the server is down (fine for demos without Fish).
# JARVIS_TTS_ENABLED=true
# JARVIS_TTS_BASE_URL=http://127.0.0.1:8080
# Autostart Docker Fish Speech when Jarvis boots and the API is down:
# JARVIS_TTS_AUTOSTART=true
# JARVIS_TTS_AUTOSTART_TIMEOUT_SECONDS=120
# JARVIS_TTS_FISH_CPU=false
# Optional Fish reference voice id (references/<id>/ on the Fish server):
# JARVIS_TTS_REFERENCE_ID=
# Fixed seed for a consistent default Fish voice (no reference clip):
# JARVIS_TTS_SEED=42
# JARVIS_TTS_TEMPERATURE=0.55
# JARVIS_TTS_TOP_P=0.7
# JARVIS_TTS_CHUNK_LENGTH=100
# JARVIS_TTS_TIMEOUT_SECONDS=60
# JARVIS_TTS_PROBE_TIMEOUT_SECONDS=2
# For a locked timbre (female↔male flips without this), put WAV +.lab pairs under
# data/fish-speech/references/<id>/ and set JARVIS_TTS_REFERENCE_ID=<id>
# Bundled local example after extract: jarvis-mcu
# JARVIS_TTS_REFERENCE_ID=jarvis-mcu

