# Example Vite env for the public demo build (copy to frontend/.env.local
# or .env.production). Never put service-role, OpenAI, or database secrets here.

VITE_DEMO_MODE=true
# Leave empty when UI and API share one origin (Nest Caddy / same host).
VITE_API_BASE_URL=

# Optional legacy fields (login removed; seats + BYOK only):
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
