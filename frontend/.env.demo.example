# Example Vite env for the public demo build (copy to frontend/.env.local).
# Never put service-role, OpenAI, or database secrets here.

VITE_DEMO_MODE=true
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key
VITE_API_BASE_URL=https://your-api.onrender.com
